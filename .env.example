# Dataverse / Power Platform (used for live OptionSet picklist sync via az CLI token)
DATAVERSE_URL=https://your-org.crm.dynamics.com
DATAVERSE_API_VERSION=v9.2

# Snowflake Admin Auth (RSA Key-Pair for DDL / Semantic View Compilation / Provisioning)
SNOWFLAKE_ACCOUNT=<YOUR_ORG>-<YOUR_ACCOUNT>
SNOWFLAKE_USER=<YOUR_SNOWFLAKE_USER>
SNOWFLAKE_PRIVATE_KEY_FILE=~/.ssh/snowflake_rsa_key.p8
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=SNOWFLAKE_LEARNING_WH
SNOWFLAKE_DATABASE=CRM_OSSIE_LAB18
SNOWFLAKE_SCHEMA=SEMANTIC

# Scoped MCP Service User Auth (PAT issued for SVC_LAB18_MCP + LAB18_WORKSTATION_IP_POLICY)
# Set SNOWFLAKE_ALLOWED_IP (IPv4 or CIDR) or leave empty to auto-detect public IP via api.ipify.org
SNOWFLAKE_ALLOWED_IP=<YOUR_PUBLIC_IP>/32
# Optional: leave blank to derive automatically from SNOWFLAKE_ACCOUNT/DATABASE/SCHEMA
SNOWFLAKE_MCP_ENDPOINT=
SNOWFLAKE_MCP_PAT=
